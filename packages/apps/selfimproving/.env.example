# Lions-Selfimproving-Task 环境变量模板
# 复制为 .env.local (dev) / .env.staging / .env.production

# ===== 基础 =====
NODE_ENV=development
PORT=3001

# ===== 数据库 =====
DATABASE_URL=file:./prisma/dev.db

# ===== Mind 端 API (cross-app 通信) =====
MIND_API_URL=http://localhost:3000

# ===== 飞轮调度 =====
# 任务批处理大小
TASK_BATCH_SIZE=30
# 智能批处理模式
TASK_SMART_MODE=false
# 问题批处理
PROBLEM_BATCH_SIZE=60
PROBLEM_SMART_MODE=false

# ===== 反思 → Task 生成 =====
# Mind Reflection -> Task 自动转换
ENABLE_REFLECTION_BRIDGE=true

# ===== WebSocket =====
WS_PORT=3003

# ===== 模型（用户自带 key；平台不提供额度、不代付）=====
# 兼容 Anthropic 协议的 base URL / key / model（MiniMax 亦走此协议）；安装器可用
#   --model-provider=minimax --model-key=<key> --model-name=<model>
# 或 --answers=<json> 配置（见 docs/productization/MODEL-CONFIG.md）。
# ANTHROPIC_BASE_URL=https://api.minimax.chat/v1
# ANTHROPIC_AUTH_TOKEN=你的 key
# ANTHROPIC_MODEL=你的模型名
# 或 MiniMax 原生 key：
# MINIMAX_API_KEY=你的 key
# 反思引擎可单独指定模型：
# REFLECT_MODEL=你的模型名
