// ============================================================================
// 2026-08-21 leo: 飞轮错误日志 (P2 错误分类落库)
//   之前: 错误只在 console / .log 打印, 无法历史分析
//   现在: 按 errorType 分类落库, 可按类型/时间/SQL 分析
//   用途: 飞轮 dashboard 错误趋势图, 自动触发重跑 (4 类错误可重试)
// ============================================================================
model FlywheelErrorLog {
  id           String   @id @default(cuid())
  errorType    String   // RATE_LIMIT | SERVER_ERROR | AUTH_ERROR | SCHEMA_INVALID | NETWORK | TIMEOUT | UNKNOWN
  stage        String   // scan | extract | write | reflect | structure | pipeline
  sourceType   String?  // SyncLog.sourceType 同源 (CLAUDE_CONVERSATION / HERMES_SESSION / PIPELINE_xxx)
  sourcePath   String?  // SyncLog.sourcePath 同源, 方便 join
  sessionId    String?  // 关联 session, 便于按 session 查错
  traceId      String?  // 关联一次完整 tick 的 traceId
  message      String   // 错误摘要 (≤ 500 字)
  rawError     String?  // 完整错误 stack (≤ 5000 字)
  httpStatus   Int?     // 原始 HTTP 状态码
  retried      Int      @default(0)  // 已重试次数
  resolved     Boolean  @default(false)  // 是否已恢复 (下次同 sourcePath 成功自动标 true)
  occurredAt   DateTime @default(now())

  @@index([errorType])
  @@index([stage])
  @@index([occurredAt])
  @@index([sourcePath])
  @@index([traceId])
}

// ============================================================================
// P3 阶段 4-6: Agent 服务注册 (SHARED-BRAIN-AGENT-REGISTRATION-DESIGN-v1.md)
// 2026-06-17 ut 设计, 14:00 morning 端 7 人评审
// ============================================================================

// 服务元数据表 (动态可扩, 加服务 INSERT 一行, 不改代码)
model AgentService {
  id              String   @id @default(cuid())
  name            String   @unique       // "lions_mind" | "mcp_agent_chat" | 未来服务
  display_name    String
  description     String
  endpoint        String                  // 默认端点 URL
  health_url      String?                 // /health 路径
  version         String
  status          String   @default("ACTIVE")  // ACTIVE | DEPRECATED | DISABLED
  enabled         Boolean  @default(true)
  default_config  String?                // JSON 字符串 (SQLite 不支持 Json 类型)
  available_perms String?                // JSON 字符串数组
  // V6-7: 幂等标识 (2026-06-18 09:48)
  //   true  = 调用天然幂等 (GET / query / idempotent POST) — 重试安全
  //   false = 副作用操作 (POST / send_message) — 重试可能重复
  //   客户端 retry 逻辑: true 自动重试, false 需 token+1 保证一次
  idempotent      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  permissions     AgentServicePermission[]

  @@index([status])
  @@index([enabled])
  @@index([idempotent])
}

// Agent 主数据表 (跟 mcp 端 agent_id 主键对齐, kebab-case 全局唯一)
model AgentRegistry {
  id            String   @id @default(cuid())
  agent_id      String   @unique        // "agent-h" (kebab)
  display_name  String
  channel       String                   // hermes / claude / mcp / custom
  host          String                   // 主机名
  avatar        String?
  profile       String?                  // JSON 字符串
  status        String   @default("ACTIVE")  // ACTIVE | REVOKED | DEPRECATED
  token_hash    String?                  // Portal API token 的 sha256 (2026-08-27: 修复 token 生成后即丢的假认证)
  // P2-A 2026-09-01 架构预留 (RBAC-ARCHITECTURE-RESERVED.md §3.2):
  //   非商业版不强制 RBAC, 字段默认 NULL = 行为不变; 商业版启用时按 role 层级过滤
  role          String?                  // OWNER / ADMIN / EDITOR / VIEWER (NULL = 未分级, 视同 EDITOR)
  tenant_id     String?                  // 多租户预留 (NULL = 单租户/全局)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  last_seen_at  DateTime?

  permissions   AgentServicePermission[]

  @@index([status])
  @@index([channel])
}

// Agent × Service 权限表 (apiKey hash + 权限 + 过期)
model AgentServicePermission {
  id            String   @id @default(cuid())
  agent_id      String                   // 关联 AgentRegistry.agent_id
  service_name  String                   // 关联 AgentService.name
  api_key_hash  String   @unique         // sha256(apiKey) —— **鉴权只查此列**; 注意: 明文并非"不存", 见下方 api_key_plain(845-851) 与其安全门
  token_id      String                   // tk_001
  expires_at    DateTime
  permissions   String                   // JSON 字符串
  config        String?                  // JSON 字符串
  status        String   @default("ACTIVE")  // ACTIVE | REVOKED | EXPIRED
  // 2026-10-27 K: 作用域 agent|admin；NULL = agent（存量兼容，不能一刀切成"已分类"）。
  //   管理操作（开线 / 发凭证 / 改归属）要求 admin；日常收发(daily_messaging) agent 即可。
  //   生命周期（scope / expires_at）由 MACS 写：审批与心跳续期；平台只建行。
  scope         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  last_used_at  DateTime?
  // P0 幂等 (2026-06-18): 1h 幂等保护窗口
  //   > now → register 沿用旧 perm, 不换 key
  //   <= now → register 正常换新 key
  //   续期: 每次 register 命中或写入都刷新
  idempotent_until DateTime?
  // P0-B23 修复 (2026-06-18 18:00): 明文 key 缓存 (只用于 idempotent_reused 重发)
  //   业务目的: 13/morning 等首次 onboard 拿占位符后, 24h 内再 register 走幂等分支,
  //     旧逻辑不返明文 (DB 只存 hash), 13 端 .env 拿不到真 key → 401
  //   安全门: 这字段权限等于 DB 明文, 必须 mode 0600, 仅 admin/grantApiKey 可读
  //   清理: force=true 重 register 会刷新, 老 key 自动失效
  //   跟 hash 字段区分: hash 用于业务鉴权 (查 hash), plain 用于紧急重发
  api_key_plain String?  // 明文, 仅 grantApiKey 端点用

  agent         AgentRegistry @relation(fields: [agent_id],     references: [agent_id],   onDelete: Cascade)
  service       AgentService  @relation(fields: [service_name], references: [name],       onDelete: Cascade)

  @@unique([agent_id, service_name])
  @@index([api_key_hash])
  @@index([status])
  @@index([expires_at])
  @@index([idempotent_until])
  @@index([scope], map: "AgentServicePermission_scope_idx")
  @@index([service_name], map: "AgentServicePermission_service_name_idx")
}

// ===== 2026-06-17 P4 NEW: Session 管理服务 (SHARED-BRAIN V3) =====
// SessionRegistry: 所有 agent 上报的 session 元信息中枢
// Pipeline 改从这表拉 PENDING session -> 提取认知 -> 更新 status
// 替代之前本地扫文件/SQLite 的方式
model SessionRegistry {
  id               String   @id @default(cuid())
  // 跨 agent + 跨 source 的全局 session_uid
  //   - claude: agent-{agent_id}:{conversation_id}
  //   - hermes: agent-{agent_id}:{session_uuid}
  //   - 未来 openai/ollama: agent-{agent_id}:{openai_thread_id}
  session_uid      String   @unique
  agent_id         String                // 关联 AgentRegistry.agent_id (logical)
  source           String                // CLAUDE_CONVERSATION / HERMES_SESSION / OPENAI_THREAD / CUSTOM
  source_id        String                // 原始 source 的 session id (claude conversation id / hermes session uuid)
  title            String?
  started_at       DateTime?
  ended_at         DateTime?
  last_message_at  DateTime?
  message_count    Int      @default(0)
  // Pipeline 处理状态
  status           String   @default("PENDING")  // PENDING / PROCESSING / PROCESSED / FAILED / SKIPPED
  processed_at     DateTime?
  processing_error String?
  // 重复检测: agent 上报时若 fingerprint 已存在则更新非关键字段, 不重复插入
  fingerprint      String   @unique     // sha256(agent_id|source|source_id)
  // 原始 payload (压缩存储, 关键消息 + 元信息, 限 1MB)
  raw_payload      String?              // JSON: { messages: [...], metadata: {...} }
  payload_size     Int      @default(0) // 字节数
  // 上报时间
  uploaded_at      DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([agent_id])
  @@index([source])
  @@index([status])
  @@index([status, uploaded_at])  // pipeline claim PENDING + oldest first
  @@index([source_id])
}

// ── DLQ (V1.1 §16.10/§21.4 + §18.7 SLO) ────────────────────
// dead_letter_queue: 投递失败 / 重试耗尽的消息或事件落库, 给 ops 排障 + SLO "DLQ 堆积 <100"
model DeadLetterQueue {
  id            String   @id @default(cuid())
  // 来源类型 — 区分是哪条链路投递失败
  //   HOOK_DELIVERY   : OpenClaw/Hermes hook → main session 投递失败 (§21.4 risk 1)
  //   REPLY_META      : REPLY_META 死循环兜底 (§21.5 risk 3)
  //   PIPELINE_SCAN   : pipeline scanner 失败 (reflection→task / task→4 scanner)
  //   SESSION_SYNC    : SessionRegistry bulkUpload 失败
  //   MCP_SEND        : send_message MCP 投递失败
  //   CUSTOM          : 其他
  source        String
  // 业务 id (message_id / session_uid / task_id / reflection_id 等)
  ref_id        String?
  // 来源 agent (谁触发的)
  agent_id      String?
  // 失败原因分级
  reason        String                    // TIMEOUT / 5XX / VALIDATION / DEAD_LETTER / CIRCUIT_BREAKER
  error_message String?                   // 具体错误文本 (限 4KB)
  // 完整 payload, JSON 字符串 (限 64KB)
  payload       String?
  // 重试统计
  retry_count   Int      @default(0)
  max_retries   Int      @default(3)
  // 状态机
  status        String   @default("OPEN") // OPEN / RETRYING / RESOLVED / EXPIRED / IGNORED
  // ops 处理记录
  resolved_at   DateTime?
  resolved_by   String?                   // ops user 或 "auto"
  resolution    String?                   // 处理结论文本
  // 时间戳
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([source, status])               // SLO 监控: 按来源统计 OPEN 数量
  @@index([agent_id])
  @@index([created_at])                   // 老化清理
}

// ── Task 模块 (原 selfimproving-task 并入) ────────────────────

model Task {
  id                  String                @id @default(cuid())
  title               String
  description         String
  background          String
  requirements        String
  materials           String
  acceptanceCriteria  String
  qualityStandards    String
  status              String                @default("PENDING")
  priority            String                @default("P2")
  sourceSummaryId     String?
  sourceReflectionIds String?
  sourceProblemId     String?
  sourceTaskId        String?
  assignedAgent       String?
  estimatedEffort     String?
  actualEffortMs      Int?
  projectPath         String?
  techStack           String?
  targetFiles         String?
  prerequisiteTaskIds String?
  retryCount          Int                   @default(0)
  maxRetries          Int                   @default(3)
  completedAt         DateTime?
  completedBy         String?
  manualReview        Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  theme               String?
  structuredContext   String?
  contextVersion      String?
  // ===== 2026-09-14 认领并发控制落地 (知识条目 cmtwa1b1900j0yn162 / 提案 cmtwb7z1o00l11j76e6tx65um) =====
  // 背景: 复核 cmu0stufv00nuki4ag8rzt5ur 判定原落地为"无实现无证据", 并给出限定命题:
  //   "新增 version/lease/expireAt/expectedOwner 字段 + 释放侧对称记 transition"。
  // 语义:
  //   version        = 乐观锁版本号; 认领/续约/释放/接管/提交都必须带 version CAS, 影响行=0 即"归属已变"。
  //   leaseExpiresAt = 租约到期(lease TTL); 认领时写入, 心跳续约; 到期且未续约才可被回收/接管。
  //   expectedOwner  = 显式归属断言(expectedOwner/takeover 要素); 与 assignedAgent 一起参与 CAS,
  //                    使"我以为自己还持锁"与"库里实际归属"的偏差可被检测, 而非静默双写。
  version             Int                   @default(0)
  leaseExpiresAt      DateTime?
  expectedOwner       String?
  // ===== 2026-07-17 V1.6 自动改进闭环 (lions-flywheel-v16-implementation-design.md §3.1) =====
  // 复用 Task 表 (V1.6 §3.3 不新增表决策), 4 type ImprovingTask: FIX_THEME/FIX_CONFLICT/MIGRATE_DATA/RE_RUN
  improvementType     String?                // FIX_THEME / FIX_CONFLICT / MIGRATE_DATA / RE_RUN
  improvementPayload  String?                // JSON: type 特定参数 (conflicts/mergeTargets/sql/theme)
  rerunResult         String?                // JSON: { before, after, delta, theme, reranAt } - V1.6 §3.1 ⑧ 验证再跑产出
  // ===== V1.8 结构化反思 (REFLECTION-STRUCTURED-DESIGN.md) =====
