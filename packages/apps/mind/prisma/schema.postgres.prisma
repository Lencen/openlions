// ===== 资源级 RBAC (2026-09-21, Q6#5; 设计见 docs/platform-logic/rbac-resource-2026-09-21.md) =====
// 授权主体 = agent 或 org 角色; 资源 = (resourceType, resourceKey) 范围; 权限 = read/write/exec/admin。
// 表由脚本手动建(与 Todo 等运行期表一致, 不用 db push —— 避免误删运行期表)。
model ResourcePermission {
  id           String   @id @default(cuid())
  subjectType  String            // agent | role
  subjectId    String            // agent_id 或 OrgRole.id
  resourceType String            // business-system | project | data-scope | api
  resourceKey  String            // 业务系统名/项目名/数据范围键
  permission   String            // read | write | exec | admin
  effect       String   @default("allow") // allow | deny
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([subjectType, subjectId, resourceType, resourceKey, permission])
  @@index([subjectType, subjectId])
}

