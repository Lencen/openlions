{
  "name": "@lions/session",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "prebuild": "DATABASE_URL=file:./dev.db prisma generate --schema=prisma/schema.prisma && DATABASE_URL=file:./dev.db prisma generate --schema=prisma/schema.postgres.prisma",
    "start": "next start -p 3002",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "next": "^14.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sql.js": "^1.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@lions/eslint-config": "workspace:*",
    "@lions/prettier-config": "workspace:*",
    "@lions/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "prettier": "@lions/prettier-config"
}
