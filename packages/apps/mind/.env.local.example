# 本机模型 override（2026-11-02）
# 安装器/升级器不再写生成模型键；这个文件只给 dev/本机用。
# 用法: cp packages/apps/mind/.env.local.example packages/apps/mind/.env.local
#      然后在 .env.local 填 ANTHROPIC_AUTH_TOKEN（不要把真 key 提交/写进 .env.example）。
#
# 当前平台可用：agent-x 官方 Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.agent-x.com/anthropic
ANTHROPIC_MODEL=agent-x-chat
# ANTHROPIC_AUTH_TOKEN=sk-...   # 只填在本机 .env.local，不提交

# 说明:
# - .env.local 被 .gitignore 忽略；安装器/升级器不覆盖它。
# - 发布包的 .env 由 lions-upgrade regenerateEnv 重建，已显式剔除模型键。
