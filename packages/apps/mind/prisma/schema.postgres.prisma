// ===== Knowledge Graph =====

model KnowledgeEntity {
  id          String    @id @default(cuid())
  name        String                   // 实体名称
  type        String                   // CONCEPT, CODE, PERSON, PROJECT, TOOL, DOMAIN
  description String?
  aliases     String?                  // 别名，多个用逗号分隔
  memoryCount Int      @default(0)     // 关联的记忆数量
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  relationsFrom KnowledgeRelation[] @relation("RelationSource")
  relationsTo   KnowledgeRelation[] @relation("RelationTarget")

  @@index([name])
  @@index([type])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  sourceId     String
  targetId     String
  relationType String                   // IS_A, PART_OF, USES, DEPENDS_ON, SIMILAR_TO, RELATED_TO
  weight       Float   @default(0.5)  // 关系权重 0-1
  source       KnowledgeEntity @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KnowledgeEntity @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
}

