// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/mind-client-pg"
}

datasource db {
  provider = "postgresql"
  // 2026-10-15 产品化 S0-1: 改由 DATABASE_URL 决定库位置，
  //   使"数据在安装根的 data/ 目录、升级只换 release 不动数据"成立。
  //   现有 .env 的 DATABASE_URL=file:./dev.db 行为不变（相对库路径按 schema 所在目录解析）。
  url      = env("MIND_DATABASE_URL")
}

// ===== Learning Module =====

model LearningPath {
  id             String      @id @default(cuid())
  title          String
  description    String?
  category       String?
  difficulty     String?
  status         String      @default("ACTIVE")
  totalHours     Float?
  completedHours Float?
  progress       Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  milestones     Milestone[]

  @@index([category])
  @@index([status])
}

model Milestone {
  id               String       @id @default(cuid())
  learningPathId   String
  title            String
  description      String?
  order            Int
  status           String       @default("PENDING")
  reflectionPrompt String?
  resources        String?
  autoReflect      Boolean      @default(true)
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  learningPath     LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  learningLogs     MilestoneLog[]
  learningSummary  LearningSummary?

  @@index([learningPathId])
  @@index([status])
}

model MilestoneLog {
  id           String    @id @default(cuid())
  milestoneId  String
  type        String    @default("LEARNING") // LEARNING, PRACTICE, REVIEW
  content     String
  duration    Int?      // minutes
  createdAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model LearningSummary {
  id           String    @id @default(cuid())
  milestoneId  String    @unique
  learningLog  String?   // 学习日志总结
  practiceSummary String? // 实践总结
  skillsGained String?   // 提炼的技能 (JSON array string)
  toolsMastered String?  // 掌握的工具 (JSON array string)
  documents    String?   // 文档成果 (JSON array string)
  demos        String?   // Demo 演示 (JSON array string)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

// ===== Memory Module =====

model Memory {
  id           String    @id @default(cuid())
  content      String
  title        String?
  tier         String    @default("WARM")
  type         String?
  sourceType   String?
  sourceId     String?
  linkedTo     String?
  domain       String?
  tags         String?
  valueScore   Float     @default(0.5)
  accessCount  Int       @default(0)
  lastAccessed DateTime?
  filePath     String?
  decayScore   Float     @default(0.0)   // 衰减系数，遗忘算法用
  lastReinforce DateTime?                // 上次强化时间
  importance   Float     @default(0.5)   // 重要性 0-1，影响晋升/降级
  // ===== 2026-10-09 round 72 (人类裁决): Memory 不写长数据, 加结构化辅助字段 =====
  scenario     String?                     // 适用场景(<=120 字): 在什么上下文成立
  standard     String?                     // 由这次记忆提炼出的规则/标准(<=120 字, 可空)
  // ===== 2026-06-06 SHARED-BRAIN-V2 新增字段 (P0-2) =====
  agentSource  String?                   // 写入来源: HERMES_AGENT / CLAUDE_AGENT / PIPELINE_HERMES / PIPELINE_CLAUDE / TASK_RESOLVED_HERMES / TASK_RESOLVED_CLAUDE / MIGRATION_HISTORICAL / MIGRATION_DUPLICATE
  contentHash  String?                   // sha256(content), 24h 去重 (SDK 业务层, 不依赖 DB UNIQUE — 业务规则: 同 agent + 24h 内 + 同 tier 才去重)
  migrated     Boolean   @default(false) // 历史数据迁移标记
  // ===== 2026-07-02 STRUCTURED-V3 新增 (P0) =====
  theme        String?                   // 2-6 字中文主题词, 页面聚合视图用
  supersededBy String?                   // 被哪条新记录取代, cuid, 冷库归档链
  supersededAt DateTime?                 // 取代时间
  reinforceCount Int     @default(0)     // 被 Resolver UPDATE 命中次数
  // ===== 2026-07-22 V1.8 结构化数据 (flywheel-structured-data-v1.md) =====
  topicId        String?                   // 指向 MemoryTopic.id, 以 topicId 为准; theme 保留作冗余索引
  // ===== 2026-10-09 round 72-D: 关联回 Practice(Practice-first 一等产物的反向引用) =====
  sourcePracticeId String?                 // 产出此条 Memory 的那个 Practice.id(session-extract 一次调用同写 Practice 与 K/M/S)
  qualityScore   Float     @default(0.0)   // 结构化质量分 0-1 (程序计算, 非 LLM 自评)
  summary        String?                   // 人类可读摘要 (结构化 content 的 summary 字段)
  // ===== 2026-09-24 uos20 #7 记忆过期自动清理 (docs/platform-logic/memory-expires-at-2026-09-24.md) =====
  //   显式到期时间契约: NULL = 永不过期(默认, 存量行为不变); 非空且 <= now 的行由
  //   scripts/memory-expiry-sweep.cjs 归档(tier=COLD, decayScore=1.0, 不硬删除)。
  expiresAt      DateTime?                 // 到期时间, NULL=永不过期
  // ===== 2026-10-16 D4（维护窗口执行）: 记忆归属字段（只加列，不做权限界面）=====
  ownerAgentId   String?                     // 归属 agent_id（NULL=未归属/共享）
  // 2026-11-02: 默认值改成 global，与**线上库实际默认**对齐（information_schema 实测三列默认均为 'global'::text）。
  //   原因（资产线 L1 规则，平台建设期档位=public）：无主行（ownerAgentId IS NULL）必须是 global；
  //   管线写入（db-writer / structure-fragments / tasks-submit）本来就不传可见性，靠库默认值落成 global。
  //   文件此前写 private 而库是 global —— 下一次 prisma migrate 会把库默认改回 private，
  //   于是"无主 + private"的脏行会从偶发变恒发（资产线 11-02 实测每 ~10 分钟长一批）。
  //   有主行的可见性由写入侧显式传（pipeline/asset-scope.writableOwner），不依赖此默认值。
  memoryScope    String   @default("global") // private | shared | global
  // ============================================
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  usedInPractices PracticeUsedMemoryLink[]  // 2026-10-09 round 72-D: 被哪些实践用过(反向引用)

  @@index([expiresAt])
  @@index([tier])
  @@index([domain])
  @@index([sourceType])
  @@index([type])
  @@index([agentSource])
  @@index([contentHash])
  @@index([migrated])
  @@index([theme])
  @@index([supersededBy])
  @@index([ownerAgentId])
  @@index([memoryScope])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "memory_content_trgm")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "memory_title_trgm")
}

// ===== Knowledge Module =====

model Knowledge {
  id          String    @id @default(cuid())
  title       String
  content     String
  qualityScore Float?   @default(0.0)  // 结构化质量分 0-1 (calcKnowledgeQuality, 2026-08-27 补齐覆盖)
  sourceType  String?   // 知识来源类型: LEARNING, PRACTICE, QUERY, SELF_SUMMARY, USER_PROVIDED
  sourceId    String?   // 关联来源ID (milestoneId, practiceId等)
  sourceDetail String?  // 来源详情描述
  agentSource String?   // 来源agent: HERMES_SESSION, CLAUDE_CONVERSATION, etc.
  tags        String?
  category    String?
  confidence  Float     @default(0.5)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  filePath    String?
  // ===== 2026-10-09 round 72: 降权标记(tier, 写端由 scripts/downweight-cognitive-rows.cjs 填; 读端由 context-seed.ts 过滤) =====
  tier         String    @default("WARM")
  // ===== 2026-07-02 STRUCTURED-V3 新增 (P0) =====
  theme        String?                  // 2-6 字中文主题词
  contentHash  String?                  // sha256(title+content)
  supersededBy String?
  supersededAt DateTime?
  reinforceCount Int    @default(0)
  // ============================================
  // ===== 2026-07-12 PHASE-B 版本联动 (sourceIds + stale) =====
  sourceLayer   String?   // "L1" (from memory) / "L2" (from knowledge)
  sourceIds     String?   // JSON array of source record ids
  sourceHash    String?   // hash(sorted(sourceIds))
  stale         Boolean   @default(false)
  staleReason   String?
  // ===== 2026-09-15 f-002 提案落地: Knowledge/SOP/RUNBOOK 产物类型分流 (proposal cmtwtf1cd05ti1j76genllwms + Reflection cmu2rrylk003722n2rxtz2jhf) =====
  // 区分陈述性知识 vs 紧急恢复步骤, 避免 runbook 内容污染 Knowledge 语义检索
  // 默认 KNOWLEDGE; SOP=标准化操作程序; RUNBOOK=紧急恢复手册 (应转入 runbook 文档/Skill, 不参与 Knowledge 主题内去重)
  contentType   String?   @default("KNOWLEDGE")   // KNOWLEDGE | SOP | RUNBOOK
  // ===== 2026-07-22 V1.8 结构化数据 =====
  mapId          String?                   // 指向 KnowledgeMap.id
  pointName      String?                   // 知识点名称 (同一 mapId 下可多个)  // ===== 2026-09-04 P2: 人机协同可信度 =====
  // ===== 2026-10-09 round 72-D: 关联回 Practice =====
  sourcePracticeId String?   // 产出此条 Knowledge 的那个 Practice.id
  // ============================================================
  humanConfirmed Boolean @default(false)   // 是否经真人确认/纠错
  verification   String?                   // 验证方法/如何复述-推理-应用 (陈述性知识口径)
  // ============================================================

  // ============================================================
  // ===== 2026-09-22 知识库结构化整理: 领域维度(与 Memory.domain 对齐) =====
  // 受控枚举: platform(平台自身机制) / agent-ops(agent运维协作) / devops(环境部署网络) /
  //   product(业务产品需求) / data(数据模型知识); 见 docs/platform-logic/knowledge-base-reorg-2026-09-22.md
  domain       String?   // 领域(受控枚举, 回填启发式见 scripts/knowledge-domain-backfill.cjs)
  // ============================================================

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  practiceKnowledgeLinks PracticeKnowledgeLink[]
  outputKnowledgeLinks   OutputKnowledgeLink[]

  @@index([domain])
  @@index([sourceType])
  @@index([category])
  @@index([agentSource])
  @@index([theme])
  @@index([contentHash])
  @@index([supersededBy])
  @@index([stale])
  // >>> asset-scoping-r5 (2026-10-23 方案 R5，窗口内加；--revert 可撤)
  ownerAgentId String?  // 归属 agent_id；NULL = 未归属/存量（按 L1 规则仍可读）
  // 2026-11-02: 默认改 global，与线上库对齐（同上；无主行必须 global）。有主行由写入侧显式传可见性。
  visibility   String   @default("global")  // private | shared | global

  @@index([ownerAgentId])
  @@index([visibility])
  // <<< asset-scoping-r5
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_content_trgm")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_title_trgm")
}

// ===== Reflection Module =====

model Reflection {
  id              String              @id @default(cuid())
  title           String
  description     String?
  category        String?
  status          String              @default("OPEN")
  priority        String?
  lesson          String?
  improvements    String?
  insight         String?
  score           Float?
  sourceType      String?             // 来源agent: HERMES_SESSION, CLAUDE_CONVERSATION, etc.
  sourceId        String?             // 来源session/对话ID
  agentSource     String?             // 2026-06-06 P1-3: 写入者 agent 枚举 (HERMES_AGENT / CLAUDE_AGENT / PIPELINE_HERMES / PIPELINE_CLAUDE / TASK_RESOLVED_HERMES / TASK_RESOLVED_CLAUDE / PROBLEM_RESOLVED_HERMES / PROBLEM_RESOLVED_CLAUDE / MIGRATION_HISTORICAL)
  milestoneId     String?
  learningPathId  String?
  knowledgeId     String?
  filePath        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  improvementActions ImprovementAction[]

  // === V3 结构化字段(用于聚类 + 决策 + 上下文组装) ===
  theme                  String?   // 主题词: "端口管理" / "异步操作" / ...
  actionType             String?   // CREATE_TASK | UPDATE_SKILL | ADD_KNOWLEDGE | ALERT | NONE
  actionConfidence       Float?    // 0-1
  structuredImprovements String?   // JSON: [{text, severity, area}]
  relatedMemoryIds       String?   // 逗号分隔
  relatedKnowledgeIds    String?
  relatedSessionIds      String?
  relatedProblemIds      String?
  rootCauseAnalysis      String?   // 50-200 字根本原因
  proposedPlan           String?   // 3-7 步实施计划(纯文本,每行一步)
  processingVersion      String?   // "v3" 标记,空/null 走 V2 老路径
  // ===== 2026-07-02 STRUCTURED-V3 新增 (P0) =====
  contentHash    String?
  supersededBy   String?
  supersededAt   DateTime?
  reinforceCount Int      @default(0)
  // ============================================

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([sourceType])
  @@index([theme])
  @@index([contentHash])
  @@index([supersededBy])
  @@index([actionType])
  @@index([processingVersion])
}

model ImprovementAction {
  id           String      @id @default(cuid())
  reflectionId String
  content      String
  status       String      @default("pending")
  effect       String?
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
  reflection   Reflection  @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  @@index([reflectionId], map: "ImprovementAction_reflectionId_idx")
}

// ===== Skills Module =====

model Skill {
  id                  String            @id @default(cuid())
  name                String            @unique
  // 2026-10-26: 双名称——businessName 给人看（原 name 的业务可读名），technicalName 给查询用（kebab/sk-<hash8>，唯一）
  //   唯一性由部分唯一索引保证（Prisma 不支持声明）：public 桶 technicalName 唯一；有主桶 (ownerAgentId, technicalName) 唯一
  businessName        String?
  technicalName       String?
  category            String
  level               String            @default("AWARENESS")
  qualityScore        Float?            @default(0.0)  // 结构化质量分 0-1 (calcSkillQuality, 2026-08-27 补齐覆盖)
  description         String?
  content             String?           // 技能完整内容 (markdown)
  source              String?           @default("LEARNED")  // LEARNED vs IMPORTED
  usageMethod         String?           // 如何使用该技能
  autoMatchRules      String?           // 自动化匹配规则 (JSON array string)
  parentSkillId       String?
  totalUsageCount     Int               @default(0)
  selfAssessment      Float?
  // ===== 2026-10-09 round 72: 降权标记(写端由 scripts/downweight-cognitive-rows.cjs; 读端由 context-seed.ts 过滤) =====
  tier                String            @default("WARM")
  validatedByPracticeId String?
  // ===== 2026-07-12 PHASE-B 版本联动 + STRUCTURED-V3 =====
  theme          String?
  contentHash    String?
  supersededBy   String?
  supersededAt   DateTime?
  reinforceCount Int               @default(0)
  sourceLayer    String?   // "L2" (from knowledge)
  sourceIds      String?   // JSON array of source record ids
  sourceHash     String?
  stale          Boolean   @default(false)
  staleReason    String?
  // ===== 2026-10-09 round 72-D: 关联回 Practice + 引用 Knowledge =====
  sourcePracticeId      String?   // 产出此 Skill 的那个 Practice.id
  referencedKnowledgeIds String?   // 引用了哪些 Knowledge(JSON array), 从 LLM 生成时填
  // ============================================================
  // ===== 2026-08-28 通用技能库规范 (docs/SKILL-SPEC.md) =====
  // 无 steps 不成 skill: content 字段承载 steps (markdown 编号步骤+命令)
  trigger        String?   // 适用场景: 什么时候用 (必填, API 校验)
  verification   String?   // 验证方法: 怎么确认成功 (必填, API 校验)
  pitfalls       String?   // 已知坑 (可选)
  platforms      String?   // 已验证环境 e.g. "ubuntu24.04/node14"
  // ===== 2026-10-09 round 70: 名称/摘要/标签 三件套 (人类裁决) =====
  // 用途(人类原话): "通过名称, 摘要, 标签快速确认技能的匹配, 匹配到的再看技能详情确认是否与当前工作匹配"。
  //   即: 列表/检索层只需 name + summary + tags 就能判断"要不要展开"; steps/content 属详情层。
  // 约束: name <= 20 且**不含省略号**(@lions/product-contract.normalizeSkillName);
  //   summary <= 80 字; tags 是规范化后的 JSON 数组字符串(<=8 个, 每个 <=12 字)。
  summary        String?   // 摘要/简要说明 (<=80 字, 列表页初筛用)
  tags           String?   // 标签 JSON 数组字符串 e.g. ["MCP","stdio"] (匹配用)
  version        Int       @default(1)  // 版本号, supersededBy 版本链
  legacy         Boolean   @default(false) // true=2026-08-28 前的无步骤存量, 只挡新增不迁移
  // ============================================================
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  parentSkill         Skill?            @relation("SkillHierarchy", fields: [parentSkillId], references: [id])
  childSkills         Skill[]            @relation("SkillHierarchy")
  toolProficiency     ToolProficiency[]
  practiceSkillLinks  PracticeSkillLink[]

  @@index([category])
  @@index([level])
  @@index([theme])
  @@index([stale])
  // >>> asset-scoping-r5 (2026-10-23 方案 R5，窗口内加；--revert 可撤)
  ownerAgentId String?  // 归属 agent_id；NULL = 未归属/存量（按 L1 规则仍可读）
  // 2026-11-02: 默认改 global，与线上库对齐（同上；无主行必须 global）。有主行由写入侧显式传可见性。
  visibility   String   @default("global")  // private | shared | global

  @@index([ownerAgentId])
  @@index([visibility])
  // <<< asset-scoping-r5
  @@index([parentSkillId], map: "Skill_parentSkillId_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "skill_name_trgm")
}

model ToolProficiency {
  id          String   @id @default(cuid())
  skillId     String
  toolName    String
  proficiency String   @default("AWARENESS")
  notes       String?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolName])
  @@index([toolName])
}

// ===== Practice Module =====

model Practice {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String
  outcome      String
  qualityScore Float?
  difficulty   Float?
  duration     Float?
  startedAt    DateTime
  completedAt  DateTime?
  // ===== 2026-10-09 round 72: 降权标记(写端由 scripts/downweight-cognitive-rows.cjs; 读端由 context-seed.ts 过滤) =====
  tier         String    @default("WARM")
  // ===== 2026-10-09 round 72-D: Practice 升级为一等产物(人类裁决: 先整理实践, 再派生认知) =====
  taskRef      String?   // 关联任务(ImprovingTask.id 或其他)
  lesson       String?   // 经验与教训(写路径: session-extract.ts insPractice; 注: 原注释引用的 scripts/check-practice-has-lesson.cjs 从未存在, 必填硬闸未实现)
  outputs      String?   // 实践产出 JSON [{type:'PR'|'KNOWLEDGE'|'MEMORY'|'SKILL'|'OUTPUT', refId, summary}]
  leftovers    String?   // 遗留改进 JSON [{description, suggestedTaskType}] -> 自动转改进任务
  // ============================================================
  // ===== 2026-07-02 STRUCTURED-V3 新增 (P0) =====
  agentSource  String?
  sourceType   String?
  sourceId     String?
  theme        String?
  contentHash  String?
  supersededBy String?
  supersededAt DateTime?
  reinforceCount Int    @default(0)
  // ============================================
  // ===== 2026-07-12 PHASE-B 版本联动 (sourceIds + stale) =====
  sourceLayer   String?   // "L1" (from memory) / "L2" (from knowledge)
  sourceIds     String?   // JSON array of source record ids
  sourceHash    String?   // hash(sorted(sourceIds))
  stale         Boolean   @default(false)
  staleReason   String?
  // ============================================================
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  skillLinks   PracticeSkillLink[]
  knowledgeLinks PracticeKnowledgeLink[]
  usedMemories   PracticeUsedMemoryLink[]
  outputLinks  PracticeOutputLink[]
  evaluations  PracticeEvaluation[]

  @@index([type])
  @@index([outcome])
  @@index([startedAt])
  @@index([agentSource])
  @@index([theme])
  @@index([contentHash])
  @@index([supersededBy])
  @@index([stale])
}

// ===== 2026-10-09 round 72-D: Practice 用到了哪些 Memory(链路闭环的最后一环) =====
model PracticeUsedMemoryLink {
  practiceId String
  memoryId   String
  role       String?    // "used_to_resolve"|"derived_from"|"context_of"... LLM 自填
  createdAt  DateTime  @default(now())
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  memory     Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  @@id([practiceId, memoryId])
  @@index([memoryId])
}

model PracticeSkillLink {
  practiceId String
