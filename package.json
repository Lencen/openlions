{
  "name": "lions",
  "private": true,
  "description": "LIONS 多 Agent 管理系统 — 面向 Agent 的认知数据平台",
  "scripts": {
    "dev": "pnpm --filter @lions/mind dev",
    "dev:session": "pnpm --filter @lions/session dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  },
  "prettier": "./packages/configs/prettier-config/index.cjs",
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1"
    }
  },
  "version": "0.4.40"
}
