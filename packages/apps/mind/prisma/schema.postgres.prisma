// ===== 2026-07-16 V1.5 反思引擎 (lions-flywheel-engine-v2-design.md §2.3.1) =====
// FlywheelReflection: 1 主题 1 条最新反思 (theme @unique)
// 输入: 主题全文 + 该主题所有 4 类产物
// 状态: PENDING → PROCESSING → OK / FAILED
model FlywheelReflection {
  id             String    @id @default(cuid())
  theme          String    @unique            // 1 主题 1 条最新 (D12)
  missedTopics   String                        // JSON.stringify(["主题1", ...])
  improvements   String                        // JSON.stringify(["lesson1", ...])
  coverageScore  Float                         // 0-1 (多批平均, D11)
  conflicts      String?                       // JSON.stringify([{memoryIds, ...}], 供 V1.6 FIX_CONFLICT 用)
  productCounts  String                        // JSON: {memory, knowledge, practice, reflection} 当前主题产物数
  lastErrors     String?                       // 上次失败的错误堆栈 (debug 用)
  status         String    @default("OK")      // OK / FAILED
  attempts       Int       @default(1)         // 尝试次数 (重试用)
  // ===== 反思产物同步写到 Memory 表 (D13, type=REFLECTION) 的反向追溯 =====
  reportedMemoryIds  String?                   // JSON.stringify([memoryId1, ...]) 本次反思同步写到 Memory 表的 id 列表 (含报告+产物)
  // ===== V1.8 结构化反思 (REFLECTION-STRUCTURED-DESIGN.md) =====
  structuredFindings     String?               // JSON: StructuredFinding[] (含 what/why/background/requirement/acceptance/priority/impact/actionType/evidenceSnippet/dedupHash/status/measuredDelta)
  reflectionGranularity  String?  @default("theme") // "theme" | "day"
  dayStats               String?               // JSON: 日反思时的飞轮统计快照 (jobsDone/failed, sessionsProcessed, coverageDelta)
  // ===== 2026-09-09 P2 合并版: 触发原因 / 输入审计 / 正文总结 / 覆盖增量 =====
  triggerReason          String?               // JSON: {kind, sinceLastHours, newProductSinceLast, manual} 为什么触发本轮反思
  sourceStats            String?               // JSON: {candidateSessions, fetchedSessions, messages, chunks, truncatedSessions, truncatedMessages, windowStart, windowEnd} 输入面审计
  summary                String?               // 反思正文总结 ≤300字 (人读; 任务背景引用)
  coverageDelta          Float?                // 本次 coverage - 上次 coverage (进度感)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([coverageScore])
  @@index([updatedAt])
}

// ===== 2026-07-22 V1.8 结构化数据聚合层 (flywheel-structured-data-v1.md §4) =====

// MemoryTopic: 记忆主题聚合, 同 theme 的 Memory 归入一个 topic
// agent 拉 1 个 topic 拿全局视图 (summary + bestMemory + subTopics)
model MemoryTopic {
  id            String    @id @default(cuid())
  name          String    @unique             // 主题名称 (= Memory.theme)
  summary       String?                       // LLM 合并生成的主题摘要
  subTopics     String?                       // JSON: ["子主题1", "子主题2"]
  relatedTopics String?                       // JSON: ["关联主题1"]
  memoryCount   Int       @default(0)         // 总条数
  activeCount   Int       @default(0)         // 活跃条数 (supersededBy IS NULL)
  coverageScore Float     @default(0.0)       // 子主题覆盖率 0-1
  freshnessScore Float    @default(0.0)       // 新鲜度 0-1
  bestMemoryId  String?                       // 最高质量 Memory 的 id
  lastMigratedAt DateTime?                    // 旧数据迁移时间 (失败重试用)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([name])
}

// KnowledgeMap: 知识地图, 同 theme 的 Knowledge 归入一个 map
// 含知识点关系 (dependsOn / leadsTo / contradicts)
model KnowledgeMap {
  id             String    @id @default(cuid())
  name           String    @unique            // 知识方向名称 (= Knowledge.theme)
  domain         String?                       // 所属领域 (如 "Database")
  summary        String?                       // LLM 合并生成的方向摘要
  knowledgePoints String?                      // JSON: [{point, statement, difficulty, dependsOn, leadsTo, contradicts, knowledgeIds}]
  completeness   Float     @default(0.0)       // 完整度 0-1
  consistency    Float     @default(0.0)       // 一致性 0-1
  practicality   Float     @default(0.0)       // 实用性 0-1
  relatedMaps    String?                       // JSON: ["关联地图1"]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
  @@index([domain])
}

// ===== 组织架构 (2026-09-21, 设计见 docs/platform-logic/org-model-2026-09-21.md) =====
