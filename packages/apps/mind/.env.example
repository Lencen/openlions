# Lions-Mind 环境变量模板
# 复制为 .env.local (dev) / .env.staging / .env.production

# ===== 基础 =====
NODE_ENV=development
PORT=3000

# ===== 数据库 =====
DATABASE_URL=file:./prisma/dev.db

# ===== 共享 SDK =====
# SDK 调用方
SDK_AGENT_SOURCE_DEFAULT=HERMES_AGENT

# ===== 反思引擎 V3 =====
# 反思生成 cron 频率 (cron 表达式)
REFLECTION_CRON=0 2 * * *

# 自动轮转
AUTO_ROTATION_ENABLED=true
AUTO_ROTATION_INTERVAL_HOURS=6

# ===== 知识库 =====
KNOWLEDGE_SEARCH_LIMIT=10
KNOWLEDGE_HOT_CACHE_TTL_HOURS=24

# ===== 模型（用户自带 key；平台不提供额度、不代付）=====
# 兼容 Anthropic 协议的 base URL / key / model（MiniMax 亦走此协议）；安装器可用
#   --model-provider=minimax --model-key=<key> --model-name=<model>
# 或 --answers=<json> 配置（见 docs/productization/MODEL-CONFIG.md）。
# ANTHROPIC_BASE_URL=https://api.minimax.chat/v1
# ANTHROPIC_AUTH_TOKEN=你的 key
# ANTHROPIC_MODEL=你的模型名
# 或 MiniMax 原生 key：
# MINIMAX_API_KEY=你的 key
# 反思引擎可单独指定模型：
# REFLECT_MODEL=你的模型名
