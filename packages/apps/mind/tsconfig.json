{
  "extends": "@lions/typescript-config/tsconfig.next.json",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "p2*-test.ts",
    "archive"
  ]
}
