# console 本机覆盖配置模板 (复制为 .env.local 后填真值)
#
# .env.local 被 .gitignore 排除, 所以**模板必须入库**, 否则新机/重装后这条配置只能靠口口相传
# —— 本文件即 2026-10-23 session-500 诊断遗留项(补 console LIONS_SESSION_API_KEY)的可复现载体。
#
# 填写真值的位置(三个 app 必须用**同一个**会话服务 key):
#   packages/apps/session/.env.local : LIONS_UPLOAD_API_KEYS  <- 会话服务 v1 API 的白名单真源
#   packages/apps/mind/.env.local    : LIONS_SESSION_API_KEY  <- mind 拉会话用
#   packages/apps/console/.env.local : 本文件下列两行       <- console 会话浏览器用
#
# 校验(不打印明文, 只比对指纹):
#   node scripts/acceptance/session-api-key-consistency.cjs

# ---- 会话服务鉴权(console → session v1 API 的 X-API-Key) ----
# canonical 名, 与 mind 同名; sessionApiKey() 的首选变量
LIONS_SESSION_API_KEY=
# 历史别名, 与 session 的 LIONS_UPLOAD_API_KEYS 同源; 保留以便旧部署回滚
SESSION_SERVICE_API_KEY=

# 交付/生产必须为 1: 严格模式下缺失即抛错, 拒绝回退开发默认 key
LIONS_STRICT_SECRETS=1

# ---- 以下为 console 其它本机覆盖项, 与本遗留项无关, 保留占位 ----
MIND_ADMIN_API_KEY=
MIND_BOOTSTRAP_API_KEY=
HERMES_MCP_API_KEY=
MACS_URL=
MIND_TRPC=